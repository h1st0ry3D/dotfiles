onboarding = false

[theme]
name = "vesper"
auto_switch = false

[keys]
{{- if eq .chezmoi.os "darwin" }}
prefix = "cmd+e"
{{- else }}
prefix = "ctrl+e"
{{- end }}
split_vertical = "prefix+d"
split_horizontal = "prefix+shift+d"
new_tab = "prefix+t"
close_pane = "prefix+w"

[ui]
agent_panel_sort = "priority"
prompt_new_tab_name = false

[experimental]
kitty_graphics = true