#!/bin/bash

# Re-apply the 4-workspace limit to the Omarchy shell pager after an update,
# since /usr/share/omarchy/shell/plugins/bar/widgets/Workspaces.qml is
# root-owned and gets reset on package upgrade.

set -uo pipefail

file=/usr/share/omarchy/shell/plugins/bar/widgets/Workspaces.qml

[ -f "$file" ] || exit 0

if grep -q 'var ids = \[1, 2, 3, 4, 5\]' "$file"; then
  # Try to patch; works when this hook runs as root (e.g. during an update).
  if sed -i 's/var ids = \[1, 2, 3, 4, 5\]/var ids = [1, 2, 3, 4]/' "$file" 2>/dev/null; then
    echo "limit-workspaces: patched Workspaces.qml to 4 slots"
  else
    echo "limit-workspaces: could not write $file (run as root or via sudo)" >&2
  fi
fi
