#!/bin/bash

# omarchy:summary=Workspace navigation clamped to a fixed range (default 1-4): does not cycle, so swiping past the last workspace does nothing

set -uo pipefail

MAX="${OMARCHY_WORKSPACE_MAX:-4}"

cur=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.name // "1"')
cur="${cur//[^0-9]/}"
cur="${cur:-1}"

case "${1:-next}" in
  prev) [ "$cur" -gt 1 ] && next=$(( cur - 1 )) || next="$cur" ;;
  *)    [ "$cur" -lt "$MAX" ] && next=$(( cur + 1 )) || next="$cur" ;;
esac

hyprctl dispatch "hl.dsp.focus({ workspace = \"$next\" })" >/dev/null 2>&1 || true
