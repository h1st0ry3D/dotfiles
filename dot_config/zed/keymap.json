// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-shift-c": [
        "editor::ToggleComments",
        {
          "advance_downwards": true
        }
      ]
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-cmd-shift-c": [
        "editor::ToggleComments",
        {
          "advance_downwards": false
        }
      ]
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-shift-space": "editor::FindAllReferences"
    }
  },
  {
    "context": "Workspace || Editor",
    "unbind": {
      "alt-f12": "terminal_panel::Toggle"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-1": "workspace::ToggleLeftDock"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "cmd-b": "workspace::ToggleLeftDock"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "cmd-r": "workspace::ToggleRightDock"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-2": "workspace::ToggleBottomDock"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "cmd-j": "workspace::ToggleBottomDock"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-3": "workspace::ToggleRightDock"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "alt-cmd-b": "workspace::ToggleRightDock"
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "cmd-1": "project_panel::ToggleFocus"
    }
  },
  {
    "context": "ProjectPanel",
    "unbind": {
      "cmd-1": "workspace::CloseActiveDock"
    }
  },
  {
    "context": "GitPanel",
    "bindings": {
      "alt-1": "git_panel::ActivateChangesTab"
    }
  },
  {
    "context": "GitPanel",
    "unbind": {
      "cmd-1": "git_panel::ActivateChangesTab"
    }
  },
  {
    "context": "GitPicker",
    "bindings": {
      "alt-1": "git_picker::ActivateBranchesTab"
    }
  },
  {
    "context": "GitPicker",
    "unbind": {
      "cmd-1": "git_picker::ActivateBranchesTab"
    }
  },
  {
    "context": "GitPanel",
    "bindings": {
      "alt-2": "git_panel::ActivateHistoryTab"
    }
  },
  {
    "context": "GitPanel",
    "unbind": {
      "cmd-2": "git_panel::ActivateHistoryTab"
    }
  },
  {
    "context": "GitPicker",
    "bindings": {
      "alt-2": "git_picker::ActivateStashTab"
    }
  },
  {
    "context": "GitPicker",
    "unbind": {
      "cmd-2": "git_picker::ActivateStashTab"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-up": "editor::MoveLineUp"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "alt-shift-up": "editor::MoveLineUp"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-down": "editor::MoveLineDown"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "alt-shift-down": "editor::MoveLineDown"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-enter": "workspace::NewTerminal"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl->": "workspace::NewTerminal"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "alt-cmd-p": "pane::TogglePinTab"
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "cmd-k shift-enter": "pane::TogglePinTab"
    }
  }
]
