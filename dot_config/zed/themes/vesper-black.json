{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Vesper Black",
  "author": "based on Vesper Blur by Taras Tereschenko",
  "themes": [
    {
      "name": "Vesper Black",
      "appearance": "dark",
      "style": {
        "background.appearance": "opaque",

        "background": "#000000",
        "surface.background": "#000000",
        "elevated_surface.background": "#161616",

        "border": "#000000",
        "border.variant": "#000000",
        "border.focused": "#FFC799",
        "border.selected": "#FFC799",
        "border.transparent": "#000000",
        "border.disabled": "#000000",

        "element.background": "#1C1C1C",
        "element.hover": "#282828",
        "element.active": "#282828",
        "element.selected": "#232323",
        "element.disabled": "#101010",
        "drop_target.background": "#FFC79950",

        "ghost_element.background": "#000000",
        "ghost_element.hover": "#282828",
        "ghost_element.active": "#282828",
        "ghost_element.selected": "#232323",
        "ghost_element.disabled": "#000000",

        "text": "#FFFFFF",
        "text.muted": "#A0A0A0",
        "text.placeholder": "#7E7E7E",
        "text.disabled": "#7E7E7E",
        "text.accent": "#FFC799",

        "icon": "#A0A0A0",
        "icon.muted": "#A0A0A0",
        "icon.disabled": "#7E7E7E",
        "icon.placeholder": "#7E7E7E",
        "icon.accent": "#FFC799",

        "status_bar.background": "#000000",
        "title_bar.background": "#000000",
        "title_bar.inactive_background": "#000000",

        "toolbar.background": "#000000",
        "tab_bar.background": "#000000",
        "tab.inactive_background": "#000000",
        "tab.active_background": "#1C1C1C",

        "search.match_background": "#FFFFFF25",
        "search.active_match_background": "#FFC79950",

        "panel.background": "#000000",
        "panel.focused_border": "#000000",
        "panel.indent_guide": "#282828",
        "panel.indent_guide_active": "#505050",
        "panel.indent_guide_hover": "#FFC799",
        "panel.overlay_background": "#161616",

        "pane.focused_border": "#000000",
        "pane_group.border": "#000000",

        "scrollbar.thumb.background": "#343434",
        "scrollbar.thumb.hover_background": "#343434",
        "scrollbar.thumb.active_background": "#343434",
        "scrollbar.thumb.border": "#000000",
        "scrollbar.track.background": "#000000",
        "scrollbar.track.border": "#000000",

        "editor.foreground": "#FFFFFF",
        "editor.background": "#000000",
        "editor.gutter.background": "#000000",
        "editor.subheader.background": "#161616",
        "editor.active_line.background": "#000000",
        "editor.highlighted_line.background": "#FFFFFF10",
        "editor.line_number": "#505050",
        "editor.active_line_number": "#FFFFFF",
        "editor.invisible": "#505050",
        "editor.wrap_guide": "#282828",
        "editor.active_wrap_guide": "#282828",
        "editor.indent_guide": "#282828",
        "editor.indent_guide_active": "#505050",
        "editor.document_highlight.read_background": "#FFFFFF15",
        "editor.document_highlight.write_background": "#FFFFFF15",

        "terminal.background": "#000000",
        "terminal.foreground": "#A0A0A0",
        "terminal.bright_foreground": "#FFFFFF",
        "terminal.dim_foreground": "#7E7E7E",
        "terminal.ansi.background": "#101010",
        "terminal.ansi.black": "#101010",
        "terminal.ansi.red": "#FF8080",
        "terminal.ansi.green": "#99FFE4",
        "terminal.ansi.yellow": "#FFC799",
        "terminal.ansi.blue": "#A0A0A0",
        "terminal.ansi.magenta": "#A0A0A0",
        "terminal.ansi.cyan": "#99FFE4",
        "terminal.ansi.white": "#FFFFFF",
        "terminal.ansi.bright_black": "#7E7E7E",
        "terminal.ansi.bright_red": "#FF8080",
        "terminal.ansi.bright_green": "#99FFE4",
        "terminal.ansi.bright_yellow": "#FFC799",
        "terminal.ansi.bright_blue": "#A0A0A0",
        "terminal.ansi.bright_magenta": "#A0A0A0",
        "terminal.ansi.bright_cyan": "#99FFE4",
        "terminal.ansi.bright_white": "#FFFFFF",

        "link_text.hover": "#FFCFA8",

        "conflict": "#FFC799",
        "conflict.background": "#FFC79915",
        "conflict.border": "#FFC799",

        "created": "#99FFE4",
        "created.background": "#99FFE415",
        "created.border": "#99FFE4",

        "deleted": "#FF8080",
        "deleted.background": "#FF808015",
        "deleted.border": "#FF8080",

        "error": "#FF8080",
        "error.background": "#2A1515",
        "error.border": "#FF8080",

        "hidden": "#7E7E7E",
        "hidden.background": "#101010",
        "hidden.border": "#101010",

        "hint": "#A0A0A0",
        "hint.background": "#1C1C1C",
        "hint.border": "#282828",

        "ignored": "#7E7E7E",
        "ignored.background": "#101010",
        "ignored.border": "#101010",

        "info": "#A0A0A0",
        "info.background": "#1C1C1C",
        "info.border": "#282828",

        "modified": "#FFC799",
        "modified.background": "#FFC79915",
        "modified.border": "#FFC799",

        "predictive": "#7E7E7E",
        "predictive.background": "#101010",
        "predictive.border": "#101010",

        "renamed": "#FFC799",
        "renamed.background": "#FFC79915",
        "renamed.border": "#FFC799",

        "success": "#99FFE4",
        "success.background": "#99FFE415",
        "success.border": "#99FFE4",

        "unreachable": "#FF8080",
        "unreachable.background": "#FF808015",
        "unreachable.border": "#FF8080",

        "warning": "#FFC799",
        "warning.background": "#2A1F15",
        "warning.border": "#FFC799",

        "players": [
          {
            "cursor": "#FFC799",
            "selection": "#FFFFFF25",
            "background": "#FFC799"
          },
          {
            "cursor": "#99FFE4",
            "selection": "#99FFE425",
            "background": "#99FFE4"
          },
          {
            "cursor": "#FF8080",
            "selection": "#FF808025",
            "background": "#FF8080"
          },
          {
            "cursor": "#A0A0A0",
            "selection": "#A0A0A025",
            "background": "#A0A0A0"
          }
        ],

        "syntax": {
          "attribute": {
            "color": "#A0A0A0"
          },
          "boolean": {
            "color": "#FFC799"
          },
          "comment": {
            "color": "#8b8b8b"
          },
          "comment.doc": {
            "color": "#8b8b8b"
          },
          "constant": {
            "color": "#FFC799"
          },
          "constructor": {
            "color": "#FFC799"
          },
          "emphasis": {
            "color": "#FFFFFF",
            "font_style": "italic"
          },
          "emphasis.strong": {
            "color": "#FFFFFF",
            "font_weight": 700
          },
          "function": {
            "color": "#FFC799"
          },
          "keyword": {
            "color": "#A0A0A0"
          },
          "label": {
            "color": "#FFC799"
          },
          "link_text": {
            "color": "#FFFFFF"
          },
          "link_uri": {
            "color": "#FFC799"
          },
          "number": {
            "color": "#FFC799"
          },
          "operator": {
            "color": "#A0A0A0"
          },
          "punctuation": {
            "color": "#A0A0A0"
          },
          "punctuation.bracket": {
            "color": "#A0A0A0"
          },
          "punctuation.delimiter": {
            "color": "#A0A0A0"
          },
          "punctuation.list_marker": {
            "color": "#A0A0A0"
          },
          "punctuation.special": {
            "color": "#A0A0A0"
          },
          "string": {
            "color": "#99FFE4"
          },
          "string.escape": {
            "color": "#A0A0A0"
          },
          "string.regex": {
            "color": "#A0A0A0"
          },
          "string.special": {
            "color": "#99FFE4"
          },
          "string.special.symbol": {
            "color": "#99FFE4"
          },
          "tag": {
            "color": "#FFC799"
          },
          "text.literal": {
            "color": "#99FFE4"
          },
          "title": {
            "color": "#FFC799"
          },
          "type": {
            "color": "#FFC799"
          },
          "variable": {
            "color": "#FFFFFF"
          },
          "variable.special": {
            "color": "#A0A0A0"
          }
        }
      }
    }
  ]
}
