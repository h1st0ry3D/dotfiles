export PATH="$HOME/.devcontainers/bin:$PATH"
export XDG_CONFIG_HOME="$HOME/.config"
export HOMEBREW_NO_ENV_HINTS=1
export EDITOR="code"

# Load .zsh completions
fpath=(~/.zsh/completions $fpath)
autoload -Uz compinit
compinit

# Set up fzf key bindings and fuzzy completion
if command -v fzf >/dev/null 2>&1; then source <(fzf --zsh); fi

# Move cursor on shift arrow key press
bindkey "\e[1;2D" backward-char
bindkey "\e[1;2C" forward-char

# Load .env.ssh (when available)
test -f $HOME/.ssh/.env.ssh && source $HOME/.ssh/.env.ssh

# Load .zsh files (when available)
test -f $HOME/.zsh/aliases && source $HOME/.zsh/aliases
test -f $HOME/.zsh/functions && source $HOME/.zsh/functions
test -f $HOME/.zshrc.local && source $HOME/.zshrc.local

# Load mise
if command -v mise >/dev/null 2>&1; then eval "$(mise activate zsh)"; fi

# Load zoxide
if command -v zoxide >/dev/null 2>&1; then eval "$(zoxide init zsh)"; fi

# Load starship (AFTER plugins, so it doesn't interfere)
if command -v starship >/dev/null 2>&1; then eval "$(starship init zsh)"; fi

# Pi
export PATH="$HOME/.local/bin:$PATH"

# colima
if command -v docker >/dev/null 2>&1; then export DOCKER_HOST="$(docker context inspect colima --format '{{.Endpoints.docker.Host}}')"; fi
